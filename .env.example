# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube a GitHub (está en .gitignore).

# --- Aplicación ---
ENTORNO=desarrollo
DEBUG=true
# true = los endpoints de /api/v1 responden datos inventados (para que el frontend avance)
MOCKS_ACTIVOS=true

# --- Base de datos ---
# Con Docker (por defecto): el contenedor "db" del docker-compose.
DATABASE_URL=postgresql+asyncpg://banco:banco_local@db:5432/banco
# Base para las pruebas (pytest la vacía en cada corrida).
DATABASE_URL_TEST=postgresql+asyncpg://banco:banco_local@db:5432/banco_test
# Supabase (cuando toque): Settings → Database → Connection string → "Session pooler".
# Cambia postgresql:// por postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:CLAVE@aws-0-xx.pooler.supabase.com:5432/postgres

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Seguridad (RNF-03) ---
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia-esto-por-un-secreto-largo
JWT_MINUTOS=5
INACTIVIDAD_SEGUNDOS=300

# --- CORS ---
# Orígenes separados por coma: Vite en desarrollo + WebView de Capacitor
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

# --- IA (Backend 2) ---
# "falso" = respuestas fijas sin GPU (pruebas y laptops sin GPU). "ollama" = modelo real.
LLM_PROVEEDOR=falso
# Ollama corre fuera de Docker, en la laptop con GPU.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODELO=llama3.1:8b
EMBEDDINGS_MODELO=bge-m3
